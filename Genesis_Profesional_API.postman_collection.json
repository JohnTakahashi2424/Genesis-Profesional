{
  "info": {
    "name": "Génesis Profesional - API Collection",
    "_postman_id": "genesis-profesional-api-collection",
    "description": "Colección oficial de endpoints de la plataforma Génesis Profesional (Facultad de Ciencia y Tecnología - UGB). Diseñada para la defensa de grado con peticiones válidas e inválidas según la rúbrica de evaluación de Backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://genesis-profesional.onrender.com/api",
      "type": "string",
      "description": "URL base del servidor Backend (o https://genesis-profesional-ugb.netlify.app/api)"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Token JWT generado automáticamente al hacer login"
    }
  ],
  "item": [
    {
      "name": "01. Autenticación",
      "item": [
        {
          "name": "POST Login [VÁLIDO - 200 OK]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        console.log('Token JWT guardado automáticamente en la colección.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"usss003024@ugb.edu.sv\",\n  \"contrasena\": \"Password123#\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Petición válida de login. Guarda el token JWT generado automáticamente en la variable {{token}} de la colección."
          }
        },
        {
          "name": "POST Login [INVÁLIDO - 422 Unprocessable Dominio No UGB]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"usuario_externo@gmail.com\",\n  \"contrasena\": \"Password123#\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Petición inválida para evidenciar validación de seguridad institucional: rechaza dominios que no sean @ugb.edu.sv con código HTTP 422."
          }
        },
        {
          "name": "POST Login [INVÁLIDO - 401 Credenciales Erróneas]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"usss003024@ugb.edu.sv\",\n  \"contrasena\": \"ClaveTotalmenteErronea999!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Petición inválida con contraseña incorrecta para evidenciar respuesta segura 401 Unauthorized sin revelar si el usuario existe o no."
          }
        },
        {
          "name": "POST Enviar Código Recuperación [Brevo SMTP API]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"usss003024@ugb.edu.sv\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/enviar-codigo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "enviar-codigo"
              ]
            },
            "description": "Envía un código de 6 dígitos mediante la API REST de Brevo (evitando bloqueos SMTP de puertos)."
          }
        },
        {
          "name": "POST Logout [Cerrar Sesión]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
